<launch>
    <!-- Запуск Gazebo -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
        <arg name="paused" value="false"/>
        <arg name="gui" value="true"/>
        <arg name="verbose" value="false"/>
    </include>

    <!-- UAV0 - запускаем первым -->
    <group ns="uav0">
        <arg name="ID" value="0"/>
        <arg name="fcu_url" value="udp://:14540@localhost:14580"/>
        
        <!-- PX4 SITL -->
        <node name="sitl" pkg="px4" type="px4" output="screen"
              args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w $(find px4)/build/px4_sitl_default/rootfs/uav0">
            <env name="PX4_SIM_MODEL" value="iris" />
            <env name="PX4_ESTIMATOR" value="ekf2" />
        </node>
        
        <!-- Spawn model -->
        <node name="spawn" pkg="gazebo_ros" type="spawn_model" output="screen"
              args="-sdf -file $(find mavlink_sitl_gazebo)/models/iris/iris.sdf -model uav0 -x 0 -y 0 -z 0 -R 0 -P 0 -Y 0"/>
              
        <!-- MAVROS -->
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="1"/>
            <arg name="namespace" value="uav0"/>
        </include>
    </group>

    <!-- UAV1 - запускаем с задержкой 15 секунд -->
    <group ns="uav1">
        <arg name="ID" value="1"/>
        <arg name="fcu_url" value="udp://:14541@localhost:14581"/>
        
        <!-- PX4 SITL с задержкой -->
        <node name="sitl" pkg="px4" type="px4" output="screen" launch-prefix="bash -c 'sleep 15; $0 $@' "
              args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w $(find px4)/build/px4_sitl_default/rootfs/uav1">
            <env name="PX4_SIM_MODEL" value="iris" />
            <env name="PX4_ESTIMATOR" value="ekf2" />
        </node>
        
        <!-- Spawn model с задержкой -->
        <node name="spawn" pkg="gazebo_ros" type="spawn_model" output="screen" launch-prefix="bash -c 'sleep 15; $0 $@' "
              args="-sdf -file $(find mavlink_sitl_gazebo)/models/iris/iris.sdf -model uav1 -x 2 -y 0 -z 0 -R 0 -P 0 -Y 0"/>
              
        <!-- MAVROS с задержкой -->
        <include file="$(find mavros)/launch/px4.launch" launch-prefix="bash -c 'sleep 15; $0 $@' ">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="2"/>
            <arg name="namespace" value="uav1"/>
        </include>
    </group>

    <!-- UAV2 - запускаем с задержкой 30 секунд -->
    <group ns="uav2">
        <arg name="ID" value="2"/>
        <arg name="fcu_url" value="udp://:14542@localhost:14582"/>
        
        <!-- PX4 SITL с задержкой -->
        <node name="sitl" pkg="px4" type="px4" output="screen" launch-prefix="bash -c 'sleep 30; $0 $@' "
              args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w $(find px4)/build/px4_sitl_default/rootfs/uav2">
            <env name="PX4_SIM_MODEL" value="iris" />
            <env name="PX4_ESTIMATOR" value="ekf2" />
        </node>
        
        <!-- Spawn model с задержкой -->
        <node name="spawn" pkg="gazebo_ros" type="spawn_model" output="screen" launch-prefix="bash -c 'sleep 30; $0 $@' "
              args="-sdf -file $(find mavlink_sitl_gazebo)/models/iris/iris.sdf -model uav2 -x 0 -y 2 -z 0 -R 0 -P 0 -Y 0"/>
              
        <!-- MAVROS с задержкой -->
        <include file="$(find mavros)/launch/px4.launch" launch-prefix="bash -c 'sleep 30; $0 $@' ">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="3"/>
            <arg name="namespace" value="uav2"/>
        </include>
    </group>
</launch>
